# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit .env.local — it holds secrets.

# IGDB uses Twitch application credentials.
# Create an application at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Supabase Postgres. Use the transaction pooler for application traffic and
# the direct/session connection for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# CheapShark requires a descriptive User-Agent. Add a contact address in production.
CHEAPSHARK_USER_AGENT=KeyFerret/0.1

# The deployed origin, used to build canonical URLs, sitemap entries, and
# links in alert emails. No account needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the /analytics dashboard (?key=...). Generate any random
# string yourself — no external account needed. Leaving this unset keeps the
# dashboard 404ing for everyone.
ANALYTICS_DASHBOARD_KEY=

# Resend (https://resend.com) sends price-alert emails. Until this is set,
# alert signups still work end-to-end — sending just no-ops with a warning.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=KeyFerret <alerts@yourdomain.com>

# Shared secret the price-alert cron job must present as
# `Authorization: Bearer <value>`. Generate any random string yourself.
# Vercel Cron sends this automatically when this env var is set; other
# schedulers need to be configured to send the same header.
CRON_SECRET=

# Google AdSense publisher ID (ca-pub-...). Leave unset to keep the site
# ad-free — every AdSlot placement renders its placeholder instead.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Skimlinks (https://skimlinks.com) publisher ID from your snippet
# (https://s.skimresources.com/js/<ID>.skimlinks.js). Rewrites outbound
# store links to affiliate-tagged equivalents client-side when a merchant
# match exists. Leave unset to load no Skimlinks script.
NEXT_PUBLIC_SKIMLINKS_ID=
